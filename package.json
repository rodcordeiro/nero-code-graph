{
  "name": "nero-code-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nero-core pack: MCP code-graph for agents",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:mcp": "node --import tsx src/mcp/stdio-main.ts",
    "mcp": "npx tsx src/mcp/stdio-main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}